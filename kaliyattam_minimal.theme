<?php

/**
 * @file
 * Functions to support theming in the Kaliyattam Minimal theme.
 */

declare(strict_types=1);

/**
 * Safely generates a URL from a route name without throwing RouteNotFoundException.
 */
function _kaliyattam_minimal_safe_url(string $route_name, array $params = []): string {
  try {
    return \Drupal\Core\Url::fromRoute($route_name, $params)->toString();
  }
  catch (\Exception $e) {
    return '';
  }
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function kaliyattam_minimal_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $id = $variables['element']['#id'] ?? '';
  if (preg_match('/^node-(post|event)-(edit-)?form/', $id)) {
    $suggestions[] = 'form__node_composer';
  }
}

/**
 * Implements hook_preprocess_form().
 */
function kaliyattam_minimal_preprocess_form(array &$variables): void {
  $form_id = $variables['element']['#form_id'] ?? '';
  if (preg_match('/^node_(post|event)_(edit_)?form$/', $form_id)) {
    $entity = NULL;
    $form_state = $variables['element']['#form_state'] ?? NULL;
    if ($form_state && method_exists($form_state, 'getFormObject')) {
      $form_object = $form_state->getFormObject();
      if ($form_object && method_exists($form_object, 'getEntity')) {
        $entity = $form_object->getEntity();
      }
    }
    if (!$entity && !empty($variables['element']['#node'])) {
      $entity = $variables['element']['#node'];
    }
    $variables['composer_is_draft'] = $entity ? !$entity->isPublished() : FALSE;
  }
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function kaliyattam_minimal_preprocess_breadcrumb(array &$variables): void {
  if (empty($variables['breadcrumb'])) {
    return;
  }
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'view.locations_map.page_1') {
    $last_key = array_key_last($variables['breadcrumb']);
    if ($last_key !== NULL) {
      $variables['breadcrumb'][$last_key]['text'] = t('Map');
    }
  }
}

/**
 * Implements hook_preprocess_views_exposed_form().
 */
function kaliyattam_minimal_preprocess_views_exposed_form(array &$variables): void {
  $variables['current_path'] = \Drupal::service('path.current')->getPath();
  $variables['current_route'] = \Drupal::routeMatch()->getRouteName();

  $variables['url_events_upcoming'] = _kaliyattam_minimal_safe_url('view.events.page_1');
  $variables['url_events_past'] = _kaliyattam_minimal_safe_url('view.events.page_2');
  $variables['url_events_calendar'] = _kaliyattam_minimal_safe_url('view.events_calendar.page_1');
  $variables['url_temples_list'] = _kaliyattam_minimal_safe_url('view.timeline_locations.page_locations');
  $variables['url_temples_map'] = _kaliyattam_minimal_safe_url('view.locations_map.page_1');
}

/**
 * Implements hook_preprocess_views_view().
 */
function kaliyattam_minimal_preprocess_views_view(array &$variables): void {
  $variables['url_events_upcoming'] = _kaliyattam_minimal_safe_url('view.events.page_1');
  $variables['url_events_past'] = _kaliyattam_minimal_safe_url('view.events.page_2');
  $variables['url_events_calendar'] = _kaliyattam_minimal_safe_url('view.events_calendar.page_1');
}

/**
 * Implements hook_preprocess_html().
 */
function kaliyattam_minimal_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (in_array($route_name, ['node.add', 'entity.node.edit_form'], TRUE)) {
    $variables['attributes']['class'][] = 'has-composer';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function kaliyattam_minimal_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if ($node) {
    $renderer = \Drupal::service('renderer');
    // Ensure author entity cacheability is attached.
    if ($node->getOwner()) {
      $renderer->addCacheableDependency($variables, $node->getOwner());
    }

    $author = $variables['author'] ?? $node->getOwner();
    $variables['author_timeline_url'] = '';
    if ($author && $author->id() > 0) {
      $variables['author_timeline_url'] = _kaliyattam_minimal_safe_url('view.timeline_user.page_timeline', ['user' => $author->id()]);
    }

    // Only in full view mode for location nodes, load and prepare referenced Theyyams with proper cacheability and media thumbnail view mode.
    if ($variables['view_mode'] === 'full' && $node->bundle() === 'location') {
      $related_theyyams = [];
      $entity_type_manager = \Drupal::entityTypeManager();
      $media_view_builder = $entity_type_manager->getViewBuilder('media');

      if ($node->hasField('field_theyyam') && !$node->get('field_theyyam')->isEmpty()) {
        foreach ($node->get('field_theyyam')->referencedEntities() as $theyyam) {
          $access_result = $theyyam->access('view', NULL, TRUE);
          $renderer->addCacheableDependency($variables, $access_result);
          if ($access_result->isAllowed()) {
            $renderer->addCacheableDependency($variables, $theyyam);
            $thumbnail_render = NULL;
            if ($theyyam->hasField('field_featured_image') && !$theyyam->get('field_featured_image')->isEmpty()) {
              $media = $theyyam->get('field_featured_image')->entity;
              if ($media) {
                $media_access = $media->access('view', NULL, TRUE);
                $renderer->addCacheableDependency($variables, $media_access);
                if ($media_access->isAllowed()) {
                  $renderer->addCacheableDependency($variables, $media);
                  $thumbnail_render = $media_view_builder->view($media, 'thumbnail');
                }
              }
            }

            $snippet = '';
            if ($theyyam->hasField('body') && !$theyyam->get('body')->isEmpty()) {
              $body_val = $theyyam->get('body')->summary ?: $theyyam->get('body')->value;
              $clean_text = trim(strip_tags((string) $body_val));
              $snippet = mb_substr($clean_text, 0, 140) . (mb_strlen($clean_text) > 140 ? '…' : '');
            }

            $related_theyyams[] = [
              'id' => $theyyam->id(),
              'title' => $theyyam->label(),
              'url' => _kaliyattam_minimal_safe_url('entity.node.canonical', ['node' => $theyyam->id()]),
              'thumbnail' => $thumbnail_render,
              'snippet' => $snippet,
            ];
          }
        }
      }
      $variables['related_theyyams'] = $related_theyyams;
    }
  }
}

/**
 * Implements hook_preprocess_menu().
 */
function kaliyattam_minimal_preprocess_menu(array &$variables): void {
  // If on front page, ensure secondary links pointing to the front target (e.g. /posts)
  // are not falsely highlighted as active alongside the Home link.
  if (\Drupal::service('path.matcher')->isFrontPage() && !empty($variables['items'])) {
    foreach ($variables['items'] as &$item) {
      if (!empty($item['url']) && $item['url'] instanceof \Drupal\Core\Url) {
        $is_front_link = ($item['url']->isRouted() && $item['url']->getRouteName() === '<front>')
          || $item['url']->toString() === \Drupal\Core\Url::fromRoute('<front>')->toString();
        if (!$is_front_link) {
          $item['in_active_trail'] = FALSE;
          $item['url']->setOption('set_active_class', FALSE);
          if (isset($item['attributes'])) {
            $item['attributes']->removeClass('is-active');
          }
        }
      }
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function kaliyattam_minimal_page_attachments_alter(array &$page): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('kaliyattam_minimal');
  $page['#attached']['html_head'][] = [
    [
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'icon',
        'href' => \Drupal::request()->getBasePath() . '/' . $theme_path . '/favicon.svg',
        'type' => 'image/svg+xml',
      ],
    ],
    'kaliyattam_minimal_svg_favicon',
  ];
}
