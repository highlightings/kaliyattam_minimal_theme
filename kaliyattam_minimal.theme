<?php

/**
 * @file
 * Functions to support theming in the Kaliyattam Minimal theme.
 */

declare(strict_types=1);

/**
 * Safely generates a URL from a route name without throwing RouteNotFoundException.
 */
function _kaliyattam_minimal_safe_url(string $route_name, array $params = []): string {
  try {
    return \Drupal\Core\Url::fromRoute($route_name, $params)->toString();
  }
  catch (\Exception $e) {
    return '';
  }
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function kaliyattam_minimal_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $id = $variables['element']['#id'] ?? '';
  if (preg_match('/^node-(post|event)-(edit-)?form/', $id)) {
    $suggestions[] = 'form__node_composer';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function kaliyattam_minimal_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node) {
    return;
  }

  $renderer = \Drupal::service('renderer');
  if ($node->getOwner()) {
    $renderer->addCacheableDependency($variables, $node->getOwner());
  }

  // Author timeline link if available.
  $author = $variables['author'] ?? $node->getOwner();
  if ($author && $author->id() > 0) {
    $variables['author_timeline_url'] = _kaliyattam_minimal_safe_url('view.timeline_user.page_timeline', ['user' => $author->id()]);
  }

  // In full view mode for location (Temple) and theyyam, find referencing events and posts.
  if ($variables['view_mode'] === 'full' && in_array($node->bundle(), ['location', 'theyyam'], TRUE)) {
    $entity_type_manager = \Drupal::entityTypeManager();
    $node_storage = $entity_type_manager->getStorage('node');
    $ref_field = $node->bundle() === 'location' ? 'field_where' : 'field_theyyam';

    // 1. Referenced Events.
    $event_nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', 1)
      ->condition($ref_field, $node->id())
      ->sort('created', 'DESC')
      ->range(0, 15)
      ->execute();

    $referenced_events = [];
    if (!empty($event_nids)) {
      foreach ($node_storage->loadMultiple($event_nids) as $event_node) {
        $renderer->addCacheableDependency($variables, $event_node);
        $referenced_events[] = [
          'id' => $event_node->id(),
          'title' => $event_node->label(),
          'url' => $event_node->toUrl()->toString(),
        ];
      }
    }
    $variables['#cache']['tags'][] = 'node_list:event';
    $variables['referenced_events'] = $referenced_events;

    // 2. Referenced Posts.
    $post_nids = \Drupal::entityQuery('node')
      ->accessCheck(TRUE)
      ->condition('type', 'post')
      ->condition('status', 1)
      ->condition($ref_field, $node->id())
      ->sort('created', 'DESC')
      ->range(0, 15)
      ->execute();

    $referenced_posts = [];
    if (!empty($post_nids)) {
      foreach ($node_storage->loadMultiple($post_nids) as $post_node) {
        $renderer->addCacheableDependency($variables, $post_node);
        $referenced_posts[] = [
          'id' => $post_node->id(),
          'title' => $post_node->label(),
          'url' => $post_node->toUrl()->toString(),
        ];
      }
    }
    $variables['#cache']['tags'][] = 'node_list:post';
    $variables['referenced_posts'] = $referenced_posts;
  }
}
