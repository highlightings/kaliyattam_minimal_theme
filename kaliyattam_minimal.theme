<?php

/**
 * @file
 * Functions to support theming in the Kaliyattam Minimal theme.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\views\Views;

/**
 * Safely generates a URL from a route name.
 *
 * Avoids throwing RouteNotFoundException when routes are uninstalled.
 */
function _kaliyattam_minimal_safe_url(string $route_name, array $params = [], array $options = []): string {
  try {
    return Url::fromRoute($route_name, $params, $options)->toString();
  }
  catch (\Throwable $e) {
    \Drupal::logger('kaliyattam_minimal')->debug('Failed generating URL for route @route: @message', [
      '@route' => $route_name,
      '@message' => $e->getMessage(),
    ]);
    return '';
  }
}

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function kaliyattam_minimal_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $form_id = $variables['element']['#form_id'] ?? '';
  if (preg_match('/^node_(post|event|theyyam|location)_(edit_)?form$/', $form_id)) {
    $suggestions[] = 'form__node_composer';
  }
}

/**
 * Implements hook_form_alter().
 */
function kaliyattam_minimal_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if (preg_match('/^node_(post|event|theyyam|location)_(edit_)?form$/', $form_id)) {
    $form_object = $form_state->getFormObject();
    if ($form_object && method_exists($form_object, 'getEntity')) {
      $entity = $form_object->getEntity();
      if ($entity && method_exists($entity, 'isPublished')) {
        $form['#composer_is_draft'] = !$entity->isNew() && !$entity->isPublished();
      }
    }
  }
}

/**
 * Implements hook_form_views_exposed_form_alter().
 */
function kaliyattam_minimal_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  if ($view) {
    $form['#km_view_id'] = $view->id();
  }
}

/**
 * Implements hook_preprocess_form().
 */
function kaliyattam_minimal_preprocess_form(array &$variables): void {
  $variables['composer_is_draft'] = (bool) ($variables['element']['#composer_is_draft'] ?? FALSE);
}

/**
 * Implements hook_preprocess_node().
 */
function kaliyattam_minimal_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node) {
    return;
  }

  $renderer = \Drupal::service('renderer');
  $owner = $node->getOwner();
  if ($owner) {
    $renderer->addCacheableDependency($variables, $owner);
  }

  // Ensure role-based cache context is attached because interaction bar
  // elements vary between anonymous (login prompt) and authenticated users.
  $variables['#cache']['contexts'][] = 'user.roles:authenticated';

  // Author details and timeline link.
  $author = $variables['author'] ?? $owner;
  if ($author) {
    $variables['author_name'] = $author->getDisplayName();
    $variables['author_initial'] = mb_strtoupper(mb_substr((string) $variables['author_name'], 0, 1));
    if ($author->id() > 0) {
      $variables['author_timeline_url'] = _kaliyattam_minimal_safe_url('view.timeline_user.page_timeline', ['user' => $author->id()]);
    }
  }
  else {
    $variables['author_name'] = (string) t('Kaliyattam Member');
    $variables['author_initial'] = 'K';
  }

  // In full view mode, optimize related views and referenced entity cards.
  // Execute views once and always bubble cacheable metadata.
  if (($variables['view_mode'] ?? '') === 'full') {
    $bundle = $node->bundle();
    $nid = $node->id();

    $displays = match ($bundle) {
      'event' => ['related_posts' => 'posts_by_event'],
      'theyyam' => [
        'related_events' => 'events_by_theyyam',
        'related_posts' => 'posts_by_theyyam',
      ],
      'location' => [
        'related_events' => 'events_by_temple',
        'related_posts' => 'posts_by_temple',
      ],
      default => [],
    };

    foreach ($displays as $var_name => $display_id) {
      $view = Views::getView('related_content');
      if ($view && $view->access($display_id)) {
        $build = $view->executeDisplay($display_id, [$nid]);
        if ($build) {
          $renderer->addCacheableDependency($variables, CacheableMetadata::createFromRenderArray($build));
          if (!empty($view->result)) {
            $variables[$var_name] = $build;
          }
        }
      }
    }

    // Render referenced Theyyam minicards on location full view using their view builder.
    if ($bundle === 'location' && $node->hasField('field_theyyam') && !$node->get('field_theyyam')->isEmpty()) {
      $theyyam_nodes = $node->get('field_theyyam')->referencedEntities();
      if (!empty($theyyam_nodes)) {
        $builder = \Drupal::entityTypeManager()->getViewBuilder('node');
        $cards = [];
        foreach ($theyyam_nodes as $theyyam_node) {
          $card = $builder->view($theyyam_node, 'minicard');
          $cards[] = $card;
          $renderer->addCacheableDependency($variables, CacheableMetadata::createFromRenderArray($card));
        }
        $variables['theyyam_minicards'] = $cards;
      }
    }
  }
}

/**
 * Implements hook_preprocess_user().
 */
function kaliyattam_minimal_preprocess_user(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $account = $variables['user'] ?? NULL;
  $variables['is_own_profile'] = $account && $current_user->isAuthenticated() && ((int) $account->id() === (int) $current_user->id());
  $variables['#cache']['contexts'][] = 'user';
}

/**
 * Implements hook_preprocess_views_exposed_form().
 */
function kaliyattam_minimal_preprocess_views_exposed_form(array &$variables): void {
  $view_id = $variables['form']['#km_view_id'] ?? '';
  if (!in_array($view_id, ['events', 'timeline_locations', 'timeline_type', 'timeline_site', 'locations_map'], TRUE)) {
    return;
  }

  $request = \Drupal::request();
  $current_user = \Drupal::currentUser();
  // Safe query parameter extraction avoiding Symfony InputBag non-scalar
  // 400 Bad Request exception.
  $query_all = $request->query->all();
  $raw_uid = $query_all['uid'] ?? '';
  $uid_param = is_scalar($raw_uid) ? (string) $raw_uid : '';
  $is_logged_in = $current_user->isAuthenticated();

  $variables['logged_in'] = $is_logged_in;
  $variables['current_uid'] = $is_logged_in ? (string) $current_user->id() : '';
  $variables['is_my'] = ($is_logged_in && $uid_param === (string) $current_user->id());
  $variables['current_path'] = $request->getPathInfo();

  // Attach cache contexts to prevent render cache pollution and ensure
  // user-specific filters and active states are securely cached.
  $variables['#cache']['contexts'][] = 'user';
  $variables['#cache']['contexts'][] = 'url.query_args:uid';
  $variables['#cache']['contexts'][] = 'url.path';

  // Provide safe route URLs so templates never throw RouteNotFoundException.
  $uid_query = $is_logged_in ? ['uid' => (string) $current_user->id()] : [];
  $variables['routes'] = [
    'events' => _kaliyattam_minimal_safe_url('view.events.page_1'),
    'events_my' => _kaliyattam_minimal_safe_url('view.events.page_1', [], ['query' => $uid_query]),
    'events_past' => _kaliyattam_minimal_safe_url('view.events.page_2'),
    'events_past_my' => _kaliyattam_minimal_safe_url('view.events.page_2', [], ['query' => $uid_query]),
    'events_map' => _kaliyattam_minimal_safe_url('view.events.page_map'),
    'events_map_my' => _kaliyattam_minimal_safe_url('view.events.page_map', [], ['query' => $uid_query]),
    'events_calendar' => _kaliyattam_minimal_safe_url('view.events_calendar.page_1'),
    'locations' => _kaliyattam_minimal_safe_url('view.timeline_locations.page_locations'),
    'locations_map' => _kaliyattam_minimal_safe_url('view.locations_map.page_1'),
    'posts' => _kaliyattam_minimal_safe_url('view.timeline_type.post_page'),
    'posts_my' => _kaliyattam_minimal_safe_url('view.timeline_type.post_page', [], ['query' => $uid_query]),
  ];
}

/**
 * Implements hook_preprocess_views_view().
 */
function kaliyattam_minimal_preprocess_views_view(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view || !in_array($view->id(), ['events_calendar', 'timeline_site'], TRUE)) {
    return;
  }

  $variables['routes'] = [
    'events' => _kaliyattam_minimal_safe_url('view.events.page_1'),
    'events_past' => _kaliyattam_minimal_safe_url('view.events.page_2'),
    'events_map' => _kaliyattam_minimal_safe_url('view.events.page_map'),
    'events_calendar' => _kaliyattam_minimal_safe_url('view.events_calendar.page_1'),
    'locations' => _kaliyattam_minimal_safe_url('view.timeline_locations.page_locations'),
    'locations_map' => _kaliyattam_minimal_safe_url('view.locations_map.page_1'),
  ];
}
