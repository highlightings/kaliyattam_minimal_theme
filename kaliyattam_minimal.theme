<?php

/**
 * @file
 * Kaliyattam Minimal theme.
 *
 * Lightweight, config-first theme for kaliyattam.com with clean, sacred aesthetics.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\node\NodeInterface;

/**
 * Implements hook_theme_suggestions_form_alter().
 */
function kaliyattam_minimal_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  $id = $variables['element']['#id'] ?? '';
  if (preg_match('/^node-(post|event)-(edit-)?form/', $id)) {
    $suggestions[] = 'form__node_composer';
  }
}

/**
 * Implements hook_preprocess_node().
 */
function kaliyattam_minimal_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }

  // Calculate comment count for the interaction bar.
  $comment_count = 0;
  if ($node->hasField('field_comments_without_title') && !$node->get('field_comments_without_title')->isEmpty()) {
    $comment_count = (int) $node->get('field_comments_without_title')->comment_count;
  }
  elseif ($node->hasField('field_comments') && !$node->get('field_comments')->isEmpty()) {
    $comment_count = (int) $node->get('field_comments')->comment_count;
  }
  $variables['comment_count'] = $comment_count;

  // Build flag action links.
  if (\Drupal::hasService('flag.link_builder')) {
    $link_builder = \Drupal::service('flag.link_builder');
    foreach (['like_node', 'offensive_content'] as $flag_id) {
      try {
        $variables['flag_' . $flag_id] = $link_builder->build('node', $node->id(), $flag_id, $variables['view_mode']);
      }
      catch (\Exception $e) {}
    }

    $variables['follow_content_enabled'] = in_array($node->bundle(), ['theyyam', 'location', 'event'], TRUE);
    if ($variables['follow_content_enabled']) {
      try {
        $variables['flag_follow_content'] = $link_builder->build('node', $node->id(), 'follow_content', $variables['view_mode']);
      }
      catch (\Exception $e) {}
    }
  }

  // Temple / Location specific view helpers.
  if ($node->bundle() === 'location') {
    // Interactive leaflet map & directions.
    if ($node->hasField('field_geofield') && !$node->get('field_geofield')->isEmpty()) {
      try {
        $variables['location_map'] = $node->get('field_geofield')->view([
          'type' => 'leaflet_formatter_default',
          'label' => 'hidden',
          'settings' => [
            'leaflet_map' => 'OSM Mapnik',
            'height' => 400,
            'height_unit' => 'px',
            'zoom' => 15,
            'minZoom' => 1,
            'maxZoom' => 20,
            'scrollWheelZoom' => FALSE,
            'reset_map' => ['control' => TRUE],
          ],
        ]);
        $geo_item = $node->get('field_geofield')->first();
        if ($geo_item && !empty($geo_item->lat) && !empty($geo_item->lon)) {
          $variables['location_directions_url'] = sprintf('https://www.google.com/maps/dir/?api=1&destination=%f,%f', $geo_item->lat, $geo_item->lon);
        }
      }
      catch (\Exception $e) {}
    }

    // Related theyyams at this location.
    if ($node->hasField('field_theyyam') && !$node->get('field_theyyam')->isEmpty()) {
      $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
      $related = [];
      foreach ($node->get('field_theyyam')->referencedEntities() as $theyyam_entity) {
        $theyyam_trans = $theyyam_entity->hasTranslation($langcode) ? $theyyam_entity->getTranslation($langcode) : $theyyam_entity;
        $media_id = NULL;
        if ($theyyam_entity->hasField('field_featured_image') && !$theyyam_entity->get('field_featured_image')->isEmpty()) {
          $media_id = $theyyam_entity->get('field_featured_image')->target_id;
        }
        $body_text = '';
        if ($theyyam_trans->hasField('body') && !$theyyam_trans->get('body')->isEmpty()) {
          $body_text = strip_tags((string) $theyyam_trans->get('body')->value);
        }
        $related[] = [
          'id' => $theyyam_trans->id(),
          'label' => $theyyam_trans->label(),
          'url' => $theyyam_trans->toUrl('canonical')->toString(),
          'media_id' => $media_id,
          'snippet' => $body_text ? (mb_substr(trim($body_text), 0, 140) . '…') : '',
        ];
      }
      $variables['related_theyyams'] = $related;
    }
  }
}

/**
 * Implements hook_preprocess_menu_local_tasks().
 */
function kaliyattam_minimal_preprocess_menu_local_tasks(array &$variables): void {
  $current_node = \Drupal::routeMatch()->getParameter('node');
  if (is_string($current_node) || is_numeric($current_node)) {
    $current_node = \Drupal\node\Entity\Node::load($current_node);
  }
  if (!$current_node instanceof NodeInterface) {
    try {
      $path = \Drupal::service('path.current')->getPath();
      if (preg_match('#^/node/(\d+)#', $path, $matches)) {
        $current_node = \Drupal\node\Entity\Node::load($matches[1]);
      }
    }
    catch (\Exception $e) {}
  }

  // Build Wiki-style toolbar for Theyyam, Temple, Event, and Post node pages.
  if ($current_node instanceof NodeInterface && in_array($current_node->bundle(), ['location', 'theyyam', 'event', 'post'], TRUE)) {
    $bundle = $current_node->bundle();
    $canonical_url = $current_node->toUrl('canonical')->toString();
    $timeline_url = $canonical_url . '/timeline';
    $edit_url = \Drupal::currentUser()->isAuthenticated()
      ? $current_node->toUrl('edit-form')->toString()
      : Url::fromRoute('user.login', [], ['query' => ['destination' => $current_node->toUrl('edit-form')->toString()]])->toString();
    $history_url = \Drupal::currentUser()->isAuthenticated()
      ? Url::fromRoute('entity.node.version_history', ['node' => $current_node->id()])->toString()
      : Url::fromRoute('user.login', [], ['query' => ['destination' => Url::fromRoute('entity.node.version_history', ['node' => $current_node->id()])->toString()]])->toString();

    $route_name = \Drupal::routeMatch()->getRouteName();
    $path_info = \Drupal::request()->getPathInfo();

    $is_timeline = (str_contains((string) $route_name, 'timeline') || str_ends_with($path_info, '/timeline'));
    $is_edit = ($route_name === 'entity.node.edit_form');
    $is_history = ($route_name === 'entity.node.version_history' || str_contains($path_info, '/revisions'));
    $is_view = (!$is_timeline && !$is_edit && !$is_history && $route_name === 'entity.node.canonical');

    $extra_tabs = [];
    if (!empty($variables['primary'])) {
      foreach (\Drupal\Core\Render\Element::children($variables['primary']) as $key) {
        $item = $variables['primary'][$key];
        if (!empty($item['#link']['url'])) {
          try {
            $url_str = $item['#link']['url']->toString();
            $title = !empty($item['#link']['title']) ? (string) $item['#link']['title'] : '';
            $title_lower = mb_strtolower(trim($title));
            if (!str_contains($url_str, '/timeline') && !str_contains($url_str, '/edit') && !str_contains($url_str, '/revisions') && !in_array($title_lower, ['view', 'കാഴ്ച', 'കാണുക', 'വിവരങ്ങൾ'])) {
              $extra_tabs[] = [
                'title' => $title,
                'url' => $url_str,
                'is_active' => !empty($item['#active']),
              ];
            }
          }
          catch (\Exception $e) {}
        }
      }
    }

    $bundle_labels = [
      'theyyam' => t('Theyyam'),
      'location' => t('Temple'),
      'event' => t('Event'),
      'post' => t('Post'),
    ];

    $variables['is_wiki_toolbar'] = TRUE;
    $variables['wiki_bundle_label'] = $bundle_labels[$bundle] ?? ucfirst($bundle);
    $variables['wiki_invite_text'] = t('You are invited to edit and improve this and other pages');
    $wiki_tabs = [
      'view' => [
        'title' => t('View'),
        'url' => $canonical_url,
        'is_active' => $is_view,
      ],
    ];

    if ($bundle === 'location') {
      $wiki_tabs['map'] = [
        'title' => t('Map'),
        'url' => $canonical_url . '#temple-map',
        'is_active' => FALSE,
      ];
    }

    if (in_array($bundle, ['location', 'theyyam', 'event'], TRUE)) {
      $wiki_tabs['timeline'] = [
        'title' => t('Timeline'),
        'url' => $timeline_url,
        'is_active' => $is_timeline,
      ];
    }

    $wiki_tabs['edit'] = [
      'title' => t('Edit'),
      'url' => $edit_url,
      'is_active' => $is_edit,
    ];
    $wiki_tabs['history'] = [
      'title' => t('History'),
      'url' => $history_url,
      'is_active' => $is_history,
    ];

    $variables['wiki_tabs'] = $wiki_tabs;
    $variables['wiki_extra_tabs'] = $extra_tabs;
  }
}
