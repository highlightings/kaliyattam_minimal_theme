{#
/**
 * @file
 * Fullcalendar view template for kaliyattam_minimal (/events/calendar).
 * Provides the [ 📅 Upcoming ] [ 🕰️ Past Events ] [ 🗓️ Calendar ] [ 🗺️ Events Map ] [ 📍 Nearby ] [ 🔍 Search ] segmented control bar.
 */
#}
{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

{{ attach_library('kaliyattam_minimal/toolbar') }}

<div {{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  <div class="timeline-toolbar events-toolbar">
    <div class="events-toolbar__header">
      <div class="events-toolbar__filters" role="group" aria-label="{{ 'Filter events'|t }}">
        {% if routes.events %}
          <a href="{{ routes.events }}" class="events-pill">
            <span aria-hidden="true">📅</span> {{ 'Upcoming'|t }}
          </a>
        {% endif %}
        <button type="button" class="events-pill events-pill--nearby" data-events-near-me aria-expanded="false" title="{{ 'Find events near your current location'|t }}">
          <span aria-hidden="true">📍</span> <span class="events-pill__label">{{ 'Near Me'|t }}</span>
        </button>
        {% if routes.events_past %}
          <a href="{{ routes.events_past }}" class="events-pill">
            <span aria-hidden="true">🕰️</span> {{ 'Past'|t }}
          </a>
        {% endif %}
        <button type="button" class="events-pill events-pill--search" data-timeline-toggle-search aria-expanded="false" title="{{ 'Search and filters'|t }}">
          <span aria-hidden="true">🔍</span> {{ 'Search'|t }}
        </button>
      </div>

      <div class="events-toolbar__views" role="group" aria-label="{{ 'View layout'|t }}">
        {% if routes.events %}
          <a href="{{ routes.events }}" class="events-view-btn" title="{{ 'Card list view'|t }}">
            <span aria-hidden="true">📑</span> {{ 'Cards'|t }}
          </a>
        {% endif %}
        {% if routes.events_map %}
          <a href="{{ routes.events_map }}" class="events-view-btn" title="{{ 'Map view'|t }}">
            <span aria-hidden="true">🗺️</span> {{ 'Map'|t }}
          </a>
        {% endif %}
        {% if routes.events_calendar %}
          <a href="{{ routes.events_calendar }}" class="events-view-btn is-active" title="{{ 'Calendar view'|t }}">
            <span aria-hidden="true">🗓️</span> {{ 'Calendar'|t }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="timeline-toolbar__search-drawer" id="timeline-search-drawer" hidden>
      <div class="timeline-toolbar__search-inner">
        <form action="{{ routes.events|default('/events') }}" method="get">
          <div class="timeline-toolbar__filter-item">
            <div class="js-form-item form-item js-form-type-textfield form-type--textfield form-item-search">
              <input type="text" name="search" placeholder="{{ 'Search events...'|t }}" class="form-text">
            </div>
          </div>
          <div class="timeline-toolbar__actions form-actions js-form-wrapper form-wrapper">
            <input type="submit" value="{{ 'Apply'|t }}" class="button js-form-submit form-submit">
          </div>
        </form>
      </div>
    </div>
  </div>

  {% if header %}
    <header class="view-header">
      {{ header }}
    </header>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  <div id="js-view-dom-id-{{ view.dom_id }}" class="fullcalendar--wrapper">{{ rows }}</div>
  <div id="fc-message"></div>
  {{ attachment_after }}

  {% if footer %}
    <footer class="view-footer">
      {{ footer }}
    </footer>
  {% endif %}

</div>
