{#
/**
 * @file
 * Fullcalendar view template for kaliyattam_minimal (/events/calendar).
 * Provides the [ 📅 Upcoming ] [ 🕰️ Past Events ] [ 🗓️ Calendar ] segmented control bar.
 */
#}
{%
  set classes = [
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

<div {{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title }}
  {{ title_suffix }}

  <div class="timeline-toolbar">
    <div class="timeline-toolbar__segmented-bar" role="group" aria-label="{{ 'Event views'|t }}">
      {% if url_events_upcoming %}
        <a href="{{ url_events_upcoming }}" class="timeline-toolbar__btn">
          <span aria-hidden="true">📅</span> {{ 'Upcoming'|t }}
        </a>
      {% endif %}
      {% if url_events_past %}
        <a href="{{ url_events_past }}" class="timeline-toolbar__btn">
          <span aria-hidden="true">🕰️</span> {{ 'Past Events'|t }}
        </a>
      {% endif %}
      {% if url_events_calendar %}
        <a href="{{ url_events_calendar }}" class="timeline-toolbar__btn is-active">
          <span aria-hidden="true">🗓️</span> {{ 'Calendar'|t }}
        </a>
      {% endif %}
      <button type="button" class="timeline-toolbar__btn timeline-toolbar__btn--search" data-timeline-toggle-search aria-expanded="false">
        <span aria-hidden="true">🔍</span> {{ 'Search'|t }}
      </button>
    </div>

    <div class="timeline-toolbar__search-drawer" id="timeline-search-drawer" hidden>
      <div class="timeline-toolbar__search-inner">
        <form action="/events" method="get">
          <div class="timeline-toolbar__filter-item">
            <div class="js-form-item form-item js-form-type-textfield form-type--textfield form-item-search">
              <input type="text" name="search" placeholder="{{ 'Search events...'|t }}" class="form-text">
            </div>
          </div>
          <div class="timeline-toolbar__actions form-actions js-form-wrapper form-wrapper">
            <input type="submit" value="{{ 'Apply'|t }}" class="button js-form-submit form-submit">
          </div>
        </form>
      </div>
    </div>
  </div>

  {% if header %}
    <header class="view-header">
      {{ header }}
    </header>
  {% endif %}

  {{ exposed }}
  {{ attachment_before }}

  <div id="js-view-dom-id-{{ view.dom_id }}" class="fullcalendar--wrapper">{{ rows }}</div>
  <div id="fc-message"></div>
  {{ attachment_after }}

  {% if footer %}
    <footer class="view-footer">
      {{ footer }}
    </footer>
  {% endif %}

</div>
