{#
/**
 * @file
 * Wrapper for node add/edit forms (post, event, theyyam, location; selected by
 * kaliyattam_minimal_theme_suggestions_form_alter in the .theme file).
 *
 * Adds the .composer card class, plus a small author header on the post form.
 * No logic: field order, widgets and groups all come from Manage form display.
 */
#}
<form{{ attributes.addClass('composer') }}>
  <div class="composer__header">
    <div class="composer__avatar-circle" aria-hidden="true">{{ user.displayname|first|upper }}</div>
    <div class="composer__meta">
      <span class="composer__author">{{ user.displayname }}</span>
      {% if composer_is_draft %}
        <span class="composer__visibility-badge composer__visibility-badge--draft">🔒 {{ 'Draft'|t }}</span>
      {% else %}
        <span class="composer__visibility-badge">🌐 {{ 'Public'|t }}</span>
      {% endif %}
    </div>
  </div>
  {{ children }}
</form>
