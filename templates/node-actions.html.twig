{% set node_target_url = url|default(path('entity.node.canonical', {'node': node.id()})) %}
{% set total_comments = 0 %}
{% if node.hasField('field_comments_without_title') and not node.get('field_comments_without_title').isEmpty() %}
  {% set total_comments = node.get('field_comments_without_title').comment_count|default(0) %}
{% elseif node.hasField('field_comments') and not node.get('field_comments').isEmpty() %}
  {% set total_comments = node.get('field_comments').comment_count|default(0) %}
{% endif %}

<div class="node-interaction-bar post-interaction-bar">
  {# 1. Favorite Button #}
  {% if logged_in %}
    {% if content.flag_bookmark is not empty %}
      {{ content.flag_bookmark }}
    {% elseif content.flag_follow_content is not empty %}
      {{ content.flag_follow_content }}
    {% elseif node is defined and node.id() %}
      {{ flaglink('node', node.id(), 'bookmark') }}
    {% endif %}
  {% else %}
    {% set login_url = path('user.login', {}, {'query': {'destination': node_target_url}}) %}
    <a href="{{ login_url }}" class="action-flag action-flag-favorite" title="{{ 'Log in to add to favorites'|t }}" aria-label="{{ 'Favorite'|t }}">
      <span class="visually-hidden">{{ 'Favorite'|t }}</span>
    </a>
  {% endif %}

  {# 2. Like Button #}
  {% if logged_in %}
    {% if content.flag_like_node is not empty %}
      {{ content.flag_like_node }}
    {% elseif node is defined and node.id() %}
      {{ flaglink('node', node.id(), 'like_node') }}
    {% endif %}
  {% else %}
    {% set login_url = path('user.login', {}, {'query': {'destination': node_target_url}}) %}
    <a href="{{ login_url }}" class="action-flag action-flag-like" title="{{ 'Log in to like this content'|t }}" aria-label="{{ 'Like'|t }}">
      <span class="visually-hidden">{{ 'Like'|t }}</span>
    </a>
  {% endif %}

  {# 3. Share Button #}
  <button type="button" class="action-flag timeline-action-btn btn-copy-link" data-url="{{ node_target_url }}" title="{{ 'Copy link to clipboard'|t }}" aria-label="{{ 'Share this content'|t }}">
    <span class="visually-hidden share-label">{{ 'Share'|t }}</span>
  </button>

  {# 4. Comments Button #}
  <a href="{{ node_target_url }}#comments" class="action-flag timeline-action-link comments-scroll-btn" title="{{ 'Comments'|t }}" aria-label="{{ 'Comments'|t }}" aria-expanded="false">
    <span class="visually-hidden">{{ 'Comments'|t }}</span>
    {% if total_comments > 0 %}
      <span class="action-count">{{ total_comments }}</span>
    {% endif %}
  </a>

  {# 5. View Post Link (for posts in list/card views) #}
  {% if node.bundle == 'post' and not page %}
    <a href="{{ node_target_url }}" class="action-flag timeline-action-link action-flag-view-post" title="{{ 'View post'|t }}">
      <span>{{ 'View post'|t }} &rarr;</span>
    </a>
  {% endif %}
</div>
