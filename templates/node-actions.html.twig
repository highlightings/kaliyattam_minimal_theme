{% set node_target_url = url|default(path('entity.node.canonical', {'node': node.id()})) %}
{% set total_comments = 0 %}
{% if node.hasField('field_comments_without_title') and not node.get('field_comments_without_title').isEmpty() %}
  {% set total_comments = node.get('field_comments_without_title').comment_count|default(0) %}
{% elseif node.hasField('field_comments') and not node.get('field_comments').isEmpty() %}
  {% set total_comments = node.get('field_comments').comment_count|default(0) %}
{% endif %}

<div class="node-interaction-bar post-interaction-bar">
  {# 1. Favorite Button #}
  {% if logged_in and content.flag_bookmark is not empty %}
    {{ content.flag_bookmark }}
  {% elseif logged_in and content.flag_follow_content is not empty %}
    {{ content.flag_follow_content }}
  {% else %}
    {% set login_url = path('user.login', {}, {'query': {'destination': node_target_url}}) %}
    <a href="{{ logged_in ? '#' : login_url }}" class="action-flag action-flag-favorite" title="{{ logged_in ? 'Favorite'|t : 'Log in to add to favorites'|t }}">
      <span class="action-icon" aria-hidden="true">♡</span><span>{{ 'Favorite'|t }}</span>
    </a>
  {% endif %}

  {# 2. Like Button #}
  {% if logged_in and content.flag_like_node is not empty %}
    {{ content.flag_like_node }}
  {% else %}
    {% set login_url = path('user.login', {}, {'query': {'destination': node_target_url}}) %}
    <a href="{{ logged_in ? '#' : login_url }}" class="action-flag action-flag-like" title="{{ logged_in ? 'Like'|t : 'Log in to like this content'|t }}">
      <span class="action-icon" aria-hidden="true">👍</span><span>{{ 'Like'|t }}</span>
    </a>
  {% endif %}

  {# 3. Share Button #}
  <button type="button" class="action-flag timeline-action-btn btn-copy-link" data-url="{{ node_target_url }}" title="{{ 'Copy link to clipboard'|t }}" aria-label="{{ 'Share this content'|t }}">
    <span class="action-icon action-icon-share" aria-hidden="true">🔗</span><span class="share-label">{{ 'Share'|t }}</span>
  </button>

  {# 4. Comments Button #}
  <a href="{{ node_target_url }}#comments" class="action-flag timeline-action-link comments-scroll-btn" title="{{ 'Jump to comments'|t }}" aria-expanded="false">
    <span class="action-icon action-icon-comments" aria-hidden="true">💬</span><span>{{ 'Comments'|t }}</span>
    {% if total_comments > 0 %}
      <span class="action-count">{{ total_comments }}</span>
    {% endif %}
  </a>
</div>
