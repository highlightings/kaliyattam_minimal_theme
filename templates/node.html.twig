{#
/**
 * @file
 * One template for every content type and view mode.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
    view_mode == 'full' ? 'wiki-node-view',
    not node.isPublished() ? 'node--unpublished',
  ]
%}

{% set author = node.getOwner() %}
{% set author_name = author.getDisplayName()|default('Kaliyattam Member'|t) %}
{% set author_initial = author_name|slice(0, 1)|upper %}
{% set author_url = author.id() > 0 ? path('view.timeline_user.page_timeline', {'user': author.id()}) : '' %}

<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}

  <div{{ content_attributes.addClass('node__content') }}>
    {# 1. FOR POSTS: LinkedIn style subtle author header #}
    {% if node.bundle == 'post' %}
      <div class="node-post-author-row">
        {% if author_url %}
          <a href="{{ author_url }}" class="node-author-avatar-sm" aria-hidden="true" tabindex="-1">
            <span class="avatar-initial">{{ author_initial }}</span>
          </a>
        {% else %}
          <div class="node-author-avatar-sm" aria-hidden="true">
            <span class="avatar-initial">{{ author_initial }}</span>
          </div>
        {% endif %}
        <div class="node-author-meta">
          <div class="node-author-name-line">
            {% if author_url %}
              <a href="{{ author_url }}" class="node-author-name">{{ author_name }}</a>
            {% else %}
              <span class="node-author-name">{{ author_name }}</span>
            {% endif %}
            <span class="node-author-badge">{{ 'Devotee Member'|t }}</span>
          </div>
          <div class="node-meta-time">
            <a href="{{ url }}" class="node-time-link" rel="bookmark" title="{{ 'View post'|t }}">
              <time datetime="{{ node.getCreatedTime()|date('c') }}">{{ node.getCreatedTime()|format_date('medium') }}</time>
            </a>
          </div>
        </div>
        {% if node.isSticky() %}
          <div class="node-pinned-badge"><span>📌 {{ 'Pinned'|t }}</span></div>
        {% endif %}
      </div>

    {# 2. FOR ALL OTHER CONTENT TYPES (Events, Temples, Theyyam): Title first, then subtle metadata #}
    {% else %}
      <div class="node-header-row">
        {% if label and not page %}
          <h2{{ title_attributes.addClass('node__title') }}>
            <a href="{{ url }}" rel="bookmark">{{ label }}</a>
          </h2>
        {% endif %}
        <div class="node-header-badges">
          {% if node.bundle == 'event' %}
            {% set event_day = (node.hasField('field_when') and not node.field_when.isEmpty()) ? node.field_when.value|date('j') : '' %}
            <span class="node-bundle-pill node-bundle-pill--event">
              {% if event_day %}
                <span class="pill-cal-icon" aria-hidden="true">
                  <span class="pill-cal-top"></span>
                  <span class="pill-cal-day">{{ event_day }}</span>
                </span>
              {% else %}
                📅
              {% endif %}
              {{ 'Event'|t }}
            </span>
          {% elseif node.bundle == 'theyyam' %}
            <span class="node-bundle-pill node-bundle-pill--theyyam">🎭 {{ 'Theyyam'|t }}</span>
          {% elseif node.bundle == 'location' %}
            <span class="node-bundle-pill node-bundle-pill--location">🛕 {{ 'Temple / Place'|t }}</span>
          {% endif %}
          {% if node.isSticky() %}
            <span class="node-pinned-badge">📌 {{ 'Pinned'|t }}</span>
          {% endif %}
        </div>
      </div>

      {# Subtle metadata line under title #}
      <div class="node-meta-subtle">
        {% if node.bundle == 'event' %}
          <span class="node-meta-submitted">
            {{ 'Submitted by'|t }}
            {% if author_url %}
              <a href="{{ author_url }}" class="node-author-link">{{ author_name }}</a>
            {% else %}
              <span class="node-author-name">{{ author_name }}</span>
            {% endif %}
          </span>
          <span class="meta-dot">&middot;</span>
          <time datetime="{{ node.getCreatedTime()|date('c') }}">{{ node.getCreatedTime()|format_date('medium') }}</time>
        {% elseif node.bundle == 'theyyam' or node.bundle == 'location' %}
          <span class="node-meta-updated">🕒 {{ 'Last updated on:'|t }} {{ node.getChangedTime()|format_date('medium') }}</span>
        {% else %}
          <time datetime="{{ node.getCreatedTime()|date('c') }}">{{ node.getCreatedTime()|format_date('medium') }}</time>
        {% endif %}
      </div>
    {% endif %}

    {{ title_suffix }}

    {# Featured image #}
    {% if content.field_featured_image is not empty %}
      <div class="node-cover-image">
        {{ content.field_featured_image }}
      </div>
    {% endif %}

    {# Main content fields: cleanly strip comments, forms, and loose flags from body #}
    <div class="node-main-fields">
      {{ content|without('field_featured_image', 'field_comments', 'field_comments_without_title', 'flag_like_node', 'flag_follow_content', 'flag_offensive_content', 'flag_bookmark', 'flag_following', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links') }}
    </div>

    {# Interaction Bar (Favorite, Like, Share, Comments) #}
    {% include '@kaliyattam_minimal/templates/node-actions.html.twig' %}

    {# Full Page Comments Section (hidden/collapsed in list views) #}
    {% if view_mode == 'full' %}
      {% set comment_content = content.field_comments_without_title|default(content.field_comments) %}
      {% if comment_content is not empty %}
        <section id="comments" class="node-comments-section comments-collapsible">
          <h3 class="comments-title">💬 {{ 'Comments'|t }}</h3>
          {{ comment_content }}
        </section>
      {% endif %}
    {% endif %}
  </div>
</article>
