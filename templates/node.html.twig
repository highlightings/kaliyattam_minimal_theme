{#
/**
 * @file
 * One template for every content type and view mode.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
    view_mode == 'full' ? 'wiki-node-view',
    not node.isPublished() ? 'node--unpublished',
  ]
%}

{% set author = node.getOwner() %}
{% set author_name = author.getDisplayName()|default('Kaliyattam Artist') %}
{% set author_initial = author_name|slice(0, 1)|upper %}
{% set author_url = '/user/' ~ author.id() ~ '/timeline?page=1' %}

<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page and node.bundle != 'post' %}
    <h1{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h1>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('node__content') }}>
    {# Author & Date Metadata Header for Posts or submitted content #}
    {% if node.bundle == 'post' or (display_submitted and view_mode == 'full') %}
      <div class="node-meta-bar">
        <div class="node-author-group">
          <a href="{{ author_url }}" class="node-author-avatar" aria-hidden="true" tabindex="-1">
            <span class="avatar-initial">{{ author_initial }}</span>
          </a>
          <div class="node-meta-info">
            <div class="node-meta-author">
              <a href="{{ author_url }}" class="node-author-link">
                <span class="icon icon-user" aria-hidden="true">👤</span>
                <span>{{ author_name }}</span>
              </a>
            </div>
            <div class="node-meta-date">
              <time datetime="{{ node.getCreatedTime()|date('c') }}">
                <span class="icon icon-calendar" aria-hidden="true">📅</span>
                <span>{{ node.getCreatedTime()|format_date('medium') }}</span>
              </time>
            </div>
          </div>
        </div>
      </div>
    {% elseif display_submitted and view_mode != 'full' %}
      <p class="node__meta">{{ author_name }} &middot; {{ date }}</p>
    {% endif %}

    {# Featured image #}
    {% if content.field_featured_image is not empty %}
      <div class="node-cover-image">
        {{ content.field_featured_image }}
      </div>
    {% endif %}

    {# Main content fields: cleanly strip comments, forms, and loose flags from body #}
    <div class="node-main-fields">
      {{ content|without('field_featured_image', 'field_comments', 'field_comments_without_title', 'flag_like_node', 'flag_follow_content', 'flag_offensive_content', 'flag_bookmark', 'flag_following', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'flag_subscribe_node', 'links') }}
    </div>

    {# Interaction Bar (Favorite, Like, Share, Comments) #}
    {% include '@kaliyattam_minimal/templates/node-actions.html.twig' %}

    {# Full Page Comments Section (hidden/collapsed in list views) #}
    {% if view_mode == 'full' %}
      {% set comment_content = content.field_comments_without_title|default(content.field_comments) %}
      {% if comment_content is not empty %}
        <section id="comments" class="node-comments-section comments-collapsible">
          <h3 class="comments-title">💬 {{ 'Comments'|t }}</h3>
          {{ comment_content }}
        </section>
      {% endif %}
    {% endif %}
  </div>
</article>
