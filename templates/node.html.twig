{#
/**
 * @file
 * One template for every content type and view mode. The look comes from the
 * view-mode class (.node--view-mode-full / -teaser / -card) in components.css.
 *
 * `label` is empty when titles are hidden (exclude_node_title), so it is
 * tested before printing.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'node--view-mode-' ~ view_mode|clean_class,
    not node.isPublished() ? 'node--unpublished',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('node__content') }}>
    {% if display_submitted %}
      <p class="node__meta">{{ author_name }} &middot; {{ date }}</p>
    {% endif %}
    {{ content }}
  </div>
</article>
