{#
/**
 * @file
 * Page layout: top strip, header, optional sidebars, footer.
 * Regions are filled by block placement (see config/optional).
 */
#}
{% set has_first = page.sidebar_first is not empty %}
{% set has_second = page.sidebar_second is not empty %}
<div class="site">
  <header class="site-header">
    {% if page.header_top %}
      <div class="site-header__top">
        <div class="container">{{ page.header_top }}</div>
      </div>
    {% endif %}
    <div class="site-header__main container">
      <div class="site-branding">{{ page.branding }}</div>
      <div class="site-nav" id="site-nav">{{ page.main_nav }}</div>
      <button type="button" class="header-button theme-toggle" data-theme-toggle aria-pressed="false" title="{{ 'Switch between light and dark mode'|t }}">
        <span class="theme-toggle__light">{{ 'Dark'|t }}</span>
        <span class="theme-toggle__dark">{{ 'Light'|t }}</span>
      </button>
      <button type="button" class="header-button nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="site-nav">{{ 'Menu'|t }}</button>
    </div>
  </header>

  <main id="main-content" class="site-main container" tabindex="-1">
    {% if page.breadcrumb %}
      <div class="site-breadcrumb">{{ page.breadcrumb }}</div>
    {% endif %}
    {{ page.highlighted }}
    <div class="layout{{ has_first ? ' layout--sidebar-first' }}{{ has_second ? ' layout--sidebar-second' }}">
      {% if has_first %}
        <aside class="sidebar sidebar--first">{{ page.sidebar_first }}</aside>
      {% endif %}
      <div class="layout__content">{{ page.content }}</div>
      {% if has_second %}
        <aside class="sidebar sidebar--second">{{ page.sidebar_second }}</aside>
      {% endif %}
    </div>
  </main>

  {% if page.footer %}
    <footer class="site-footer">
      <div class="container">{{ page.footer }}</div>
    </footer>
  {% endif %}
</div>
