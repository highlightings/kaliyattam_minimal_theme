{#
/**
 * @file
 * Custom exposed filter template for past events view (/events/past).
 * Provides the [ 📅 Upcoming ] [ 🕰️ Past Events ] [ 🗓️ Calendar ] [ 🗺️ Events Map ] [ 📍 Nearby ] [ 🔍 Search ]
 * segmented control bar and a collapsible search drawer with native Geofield Proximity search.
 */
#}
{% if q is not empty %}
  {{ q }}
{% endif %}

{% set current_path = app.request.pathInfo %}
{% set is_past = true %}
{% set is_cal = false %}
{% set is_map = false %}
{% set is_upcoming = false %}

{% set search_val = form.search['#value']|default('') %}
{% set prox_origin = form.proximity_wrapper.proximity.source_configuration.origin_address['#value']|default(form.proximity.source_configuration.origin_address['#value']|default('')) %}
{% set has_search = search_val is not empty or prox_origin is not empty %}

<div class="timeline-toolbar">
  <div class="timeline-toolbar__segmented-bar" role="group" aria-label="{{ 'Event views'|t }}">
    <a href="/events" class="timeline-toolbar__btn">
      <span aria-hidden="true">📅</span> {{ 'Upcoming'|t }}
    </a>
    <a href="/events/past" class="timeline-toolbar__btn is-active">
      <span aria-hidden="true">🕰️</span> {{ 'Past Events'|t }}
    </a>
    <a href="/events/calendar" class="timeline-toolbar__btn">
      <span aria-hidden="true">🗓️</span> {{ 'Calendar'|t }}
    </a>
    <a href="/events/map" class="timeline-toolbar__btn">
      <span aria-hidden="true">🗺️</span> {{ 'Events Map'|t }}
    </a>
    <button type="button" class="timeline-toolbar__btn{{ prox_origin is not empty ? ' is-active' }}" data-timeline-nearby aria-expanded="{{ has_search ? 'true' : 'false' }}" title="{{ 'Search events near a location or city'|t }}">
      <span aria-hidden="true">📍</span> {{ 'Nearby'|t }}
    </button>
    <button type="button" class="timeline-toolbar__btn timeline-toolbar__btn--search{{ has_search ? ' is-active' }}" data-timeline-toggle-search aria-expanded="{{ has_search ? 'true' : 'false' }}">
      <span aria-hidden="true">🔍</span> {{ 'Search'|t }}
    </button>
  </div>

  <div class="timeline-toolbar__search-drawer{{ has_search ? ' is-open' }}" id="timeline-search-drawer" {{ not has_search ? 'hidden' }}>
    <div class="timeline-toolbar__search-inner">
      {% if form.search %}
        <div class="timeline-toolbar__filter-item">
          {{ form.search }}
        </div>
      {% endif %}
      {% if form.proximity_wrapper %}
        <div class="timeline-toolbar__filter-item timeline-toolbar__filter-item--proximity">
          {{ form.proximity_wrapper }}
        </div>
      {% elseif form.proximity %}
        <div class="timeline-toolbar__filter-item timeline-toolbar__filter-item--proximity">
          {{ form.proximity }}
        </div>
      {% endif %}
      <div class="timeline-toolbar__actions">
        {{ form.actions }}
      </div>
    </div>
  </div>

  <div class="visually-hidden">
    {{ form|without('q', 'search', 'proximity', 'proximity_wrapper', 'actions') }}
  </div>
</div>
