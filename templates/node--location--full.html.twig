{#
/**
 * @file
 * Temple / Location node in full view mode.
 * Clean, uncluttered layout matching the sacred Kaliyattam design.
 */
#}
<article{{ attributes.addClass('node', 'node--type-location', 'node--view-mode-full', 'wiki-node-view', not node.isPublished() ? 'node--unpublished') }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h1{{ title_attributes.addClass('node__title') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h1>
  {% endif %}
  {{ title_suffix }}

  <div{{ content_attributes.addClass('node__content') }}>
    {# Cover / Featured Image #}
    {% if content.field_featured_image is not empty %}
      <div class="location-cover-image">
        {{ content.field_featured_image }}
      </div>
    {% endif %}

    {# Address details #}
    {% if content.field_location_address is not empty %}
      <div class="location-address-box">
        <span class="location-address-icon" aria-hidden="true">📍</span>
        <div class="location-address-text">
          {{ content.field_location_address }}
        </div>
      </div>
    {% endif %}

    {# Temple Map Section #}
    {% if content.field_geofield is not empty or (node.hasField('field_geofield') and not node.field_geofield.isEmpty()) %}
      <section id="temple-map" class="temple-map-section">
        <div class="temple-map-header">
          <h2 class="temple-map-title">
            <span class="temple-map-icon" aria-hidden="true">🗺️</span>
            <span>{{ 'Temple Location & Map'|t }}</span>
          </h2>
          {% if node.hasField('field_geofield') and not node.field_geofield.isEmpty() %}
            {% set geo = node.field_geofield.0 %}
            {% if geo.lat and geo.lon %}
              <a href="https://www.google.com/maps/dir/?api=1&destination={{ geo.lat }},{{ geo.lon }}" target="_blank" rel="noopener noreferrer" class="button button--directions">
                <span>🧭 {{ 'Get directions'|t }}</span>
              </a>
            {% endif %}
          {% endif %}
        </div>
        <div class="temple-map-canvas">
          {{ content.field_geofield }}
        </div>
      </section>
    {% endif %}

    {# Related Theyyams at this Temple #}
    {% if node.field_theyyam is not empty %}
      <section class="theyyam-related">
        <h2 class="theyyam-related-title">
          <span class="theyyam-related-icon" aria-hidden="true">🎭</span>
          <span>{{ 'Theyyam at this temple'|t }}</span>
        </h2>
        <div class="theyyam-cards-grid">
          {% for theyyam_item in node.field_theyyam %}
            <div class="theyyam-card-wrapper">
              {{ drupal_entity('node', theyyam_item.target_id, 'minicard') }}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# Main Content & Description #}
    <div class="node-main-fields">
      {{ content|without('field_featured_image', 'field_location_address', 'field_geofield', 'field_theyyam', 'field_media', 'field_comments', 'field_comments_without_title', 'flag_like_node', 'flag_follow_content', 'flag_offensive_content', 'flag_following', 'flag_sticky_timeline', 'flag_sticky_user_timeline', 'links') }}
    </div>

    {# Referenced Events & Posts #}
    {% if referenced_events is not empty or referenced_posts is not empty %}
      <section class="referenced-references-section">
        {% if referenced_events is not empty %}
          <div class="referenced-block">
            <h3 class="referenced-block-title">
              <span class="referenced-icon" aria-hidden="true">📅</span>
              <span>{{ 'Related Events'|t }}</span>
            </h3>
            <ul class="referenced-titles-list">
              {% for event in referenced_events %}
                <li class="referenced-title-item">
                  <a href="{{ event.url }}" class="referenced-title-link">{{ event.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        {% if referenced_posts is not empty %}
          <div class="referenced-block">
            <h3 class="referenced-block-title">
              <span class="referenced-icon" aria-hidden="true">📝</span>
              <span>{{ 'Related Posts'|t }}</span>
            </h3>
            <ul class="referenced-titles-list">
              {% for post in referenced_posts %}
                <li class="referenced-title-item">
                  <a href="{{ post.url }}" class="referenced-title-link">{{ post.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </section>
    {% endif %}

    {% include '@kaliyattam_minimal/templates/node-actions.html.twig' %}

    {# Wiki Page Metadata Footer #}
    <footer class="wiki-node-footer">
      <div class="wiki-last-updated">
        <span>🕒 {{ 'Last updated on'|t }} {{ node.getChangedTime()|format_date('medium') }}</span>
      </div>
      <div class="wiki-history-links">
        <a href="{{ logged_in ? path('entity.node.version_history', {'node': node.id}) : path('user.login', {}, {'query': {'destination': path('entity.node.version_history', {'node': node.id})}}) }}">
          <span>📖 {{ 'View versions & revision history'|t }}</span>
        </a>
      </div>
    </footer>

    {% set comment_content = content.field_comments_without_title|default(content.field_comments) %}
    {% if comment_content is not empty %}
      <section id="comments" class="node-comments-section comments-collapsible">
        <h3 class="comments-title">💬 {{ 'Comments'|t }}</h3>
        {{ comment_content }}
      </section>
    {% endif %}
  </div>
</article>
