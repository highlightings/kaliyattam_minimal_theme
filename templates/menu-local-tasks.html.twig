{#
/**
 * @file
 * Local tasks. On wiki node pages (Theyyam, Temple, Event, Post),
 * renders the clean Wikipedia-style toolbar matching the design.
 */
#}
{% if is_wiki_toolbar %}
  <div class="vector-page-toolbar">
    <div class="vector-page-toolbar-container">
      <div id="left-navigation">
        <nav aria-label="{{ 'Namespaces'|t }}">
          <div id="p-associated-pages" class="vector-menu vector-menu-tabs">
            <div class="vector-menu-content">
              <ul class="vector-menu-content-list">
                <li id="ca-nstab-main" class="selected is-active">
                  <a href="{{ wiki_tabs.view.url }}"><span>{{ wiki_bundle_label }}</span></a>
                </li>
              </ul>
            </div>
          </div>
        </nav>
        <div class="vector-wiki-invite-line" title="{{ 'Community contribution'|t }}">
          <span class="invite-icon" aria-hidden="true">&#9998;</span>
          <span class="invite-text">{{ wiki_invite_text }}</span>
        </div>
      </div>
      <div id="right-navigation">
        <nav aria-label="{{ 'Views'|t }}">
          <div id="p-views" class="vector-menu vector-menu-tabs">
            <div class="vector-menu-content">
              <ul class="vector-menu-content-list tabs tabs--primary">
                <li id="ca-view" class="{% if wiki_tabs.view.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.view.url }}" class="{% if wiki_tabs.view.is_active %}is-active{% endif %}">
                    <span>{{ 'View'|t }}</span>
                  </a>
                </li>
                {% if wiki_tabs.map is defined %}
                  <li id="ca-map" class="{% if wiki_tabs.map.is_active %}selected is-active{% endif %}">
                    <a href="{{ wiki_tabs.map.url }}" class="{% if wiki_tabs.map.is_active %}is-active{% endif %}">
                      <span>{{ 'Map'|t }}</span>
                    </a>
                  </li>
                {% endif %}
                {% if wiki_tabs.timeline is defined %}
                  <li id="ca-timeline" class="{% if wiki_tabs.timeline.is_active %}selected is-active{% endif %}">
                    <a href="{{ wiki_tabs.timeline.url }}" class="{% if wiki_tabs.timeline.is_active %}is-active{% endif %}">
                      <span>{{ 'Timeline'|t }}</span>
                    </a>
                  </li>
                {% endif %}
                <li id="ca-edit" class="{% if wiki_tabs.edit.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.edit.url }}" class="{% if wiki_tabs.edit.is_active %}is-active{% endif %}">
                    <span>{{ 'Edit'|t }}</span>
                  </a>
                </li>
                <li id="ca-history" class="{% if wiki_tabs.history.is_active %}selected is-active{% endif %}">
                  <a href="{{ wiki_tabs.history.url }}" class="{% if wiki_tabs.history.is_active %}is-active{% endif %}">
                    <span>{{ 'History'|t }}</span>
                  </a>
                </li>
                {% if wiki_extra_tabs is not empty %}
                  <li class="vector-menu-dropdown">
                    <details class="vector-tools-dropdown">
                      <summary class="vector-tools-summary"><span>{{ 'More'|t }} &#9662;</span></summary>
                      <ul class="vector-tools-menu">
                        {% for extra in wiki_extra_tabs %}
                          <li class="{% if extra.is_active %}is-active{% endif %}">
                            <a href="{{ extra.url }}" class="{% if extra.is_active %}is-active{% endif %}">
                              <span>{{ extra.title }}</span>
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </details>
                  </li>
                {% endif %}
              </ul>
            </div>
          </div>
        </nav>
      </div>
    </div>
  </div>
{% elseif primary %}
  <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
  <ul class="tabs tabs--primary">{{ primary }}</ul>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="tabs tabs--secondary">{{ secondary }}</ul>
{% endif %}
