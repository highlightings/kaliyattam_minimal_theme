{#
/**
 * @file
 * Default theme implementation to present all user data in kaliyattam_minimal.
 *
 * Prevents displaying the follow button when a user views their own profile.
 */
#}
{% set is_own_profile = is_own_profile|default(false) %}

<article{{ attributes.addClass('user-profile-card') }}>
  {% if content %}
    {% if is_own_profile %}
      {{ content|without('flag_following') }}
    {% else %}
      {{ content }}
    {% endif %}
  {% endif %}
</article>
